# Copy to .env — never commit .env. JWT: npm run generate-secrets

NODE_ENV=development
# NODE_ENV=production

PORT=5025

TRUST_PROXY=false
# TRUST_PROXY=true

APP_URL=http://localhost:3000
# APP_URL=https://buytly.com

CORS_ORIGIN=http://localhost:3000,http://localhost:3025,http://127.0.0.1:3025
# CORS_ORIGIN=https://buytly.com,https://www.buytly.com

API_URL=http://localhost:5025/api/v1
# API_URL=https://api.buytly.com/api/v1

SWAGGER_ENABLED=true
# SWAGGER_ENABLED=false

MONGODB_URI=mongodb://localhost:27017/buytly

JWT_ACCESS_SECRET=change-me-run-npm-generate-secrets-xx
JWT_REFRESH_SECRET=change-me-run-npm-generate-secrets-yy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCS_KEY_FILE=./gcs-service-account.json

# Email — smtp (default) or sendgrid (see deployment.md)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxx
# SMTP_FROM=noreply@buytly.com

# GCS orphan cleanup grace period (hours) for scripts/gcs-orphan-cleanup.js
# GCS_ORPHAN_GRACE_HOURS=48

REDIS_URL=
# REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=

# Demo seed (npm run seed / seed:reset) — development only
# SEED_PASSWORD=BuytlyDemo2026!
# SEED_FORCE=true
