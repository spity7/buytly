# Copy to .env — never commit .env. JWT: npm run generate-secrets

NODE_ENV=development
# NODE_ENV=production

PORT=5025

TRUST_PROXY=false
# TRUST_PROXY=true

# Fallback for email links when a site has no public URL (sites use SITE_PUBLIC_URL_* / sites.publicUrl)
APP_URL=http://localhost:3000
# APP_URL=https://buytly.com

# Per-site public URLs for partner listing links and email links (development defaults apply if unset)
# SITE_PUBLIC_URL_BUILDWISE=http://localhost:3001
# SITE_PUBLIC_URL_BUYTLY=http://localhost:3000
# SITE_PUBLIC_URL_BLOCK57=http://localhost:3002

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3025,http://localhost:3026,http://localhost:3027,http://127.0.0.1:3025,http://127.0.0.1:3026,http://127.0.0.1:3027
# CORS_ORIGIN=https://buytly.com,https://www.buytly.com,https://buildwise-engineering.com,https://www.buildwise-engineering.com,https://block-57.com,https://www.block-57.com

# Fallback tenant when Origin/X-Site-Slug is absent (tests, scripts)
# DEFAULT_SITE_SLUG=buytly

API_URL=http://localhost:5025/api/v1
# API_URL=https://api.buytly.com/api/v1

SWAGGER_ENABLED=true
# SWAGGER_ENABLED=false

MONGODB_URI=mongodb://localhost:27017/buytly

JWT_ACCESS_SECRET=change-me-run-npm-generate-secrets-xx
JWT_REFRESH_SECRET=change-me-run-npm-generate-secrets-yy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCS_KEY_FILE=./gcs-service-account.json

# Email — smtp (default) or sendgrid (see deployment.md)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxx
# SMTP_FROM=noreply@buytly.com

# GCS orphan cleanup grace period (hours) for scripts/gcs-orphan-cleanup.js
# GCS_ORPHAN_GRACE_HOURS=48

# OpenStreetMap Overpass (optional — defaults try kumi.systems then overpass-api.de)
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
# OVERPASS_USER_AGENT=Buytly/1.0 (+https://buytly.com)

# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in client/.env.local (or client/.env) and repo root `.env` for Docker
GOOGLE_CLIENT_ID=

# Contact form inbox (also shown on site via NEXT_PUBLIC_SUPPORT_EMAIL).
# Fallback only: a site's branding.contactInboxEmail (e.g. Block 57) takes precedence.
CONTACT_INBOX_EMAIL=buytlyonline@gmail.com

# Demo seed (npm run seed / seed:reset) — development only
# SEED_PASSWORD=BuytlyDemo2026!
# SEED_FORCE=true

# Block 57 bootstrap (npm run seed:block57) — see docs/deployment.md.
# Prefer passing these for the run only; do not keep a production password here.
# BLOCK57_ADMIN_EMAIL=
# BLOCK57_ADMIN_PASSWORD=
# Optional project pin (set both; first insert only). Default is approximate.
# BLOCK57_LAT=5.5786
# BLOCK57_LNG=-0.1745
