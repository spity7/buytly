# Copy to .env — never commit .env. JWT: npm run generate-secrets

NODE_ENV=development
# NODE_ENV=production

PORT=5000

TRUST_PROXY=false
# TRUST_PROXY=true

APP_URL=http://localhost:3000
# APP_URL=https://buytly.com

CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://buytly.com,https://www.buytly.com

API_URL=http://localhost:5000/api/v1
# API_URL=https://api.buytly.com/api/v1

SWAGGER_ENABLED=true
# SWAGGER_ENABLED=false

MONGODB_URI=mongodb://localhost:27017/buytly

JWT_ACCESS_SECRET=change-me-run-npm-generate-secrets-xx
JWT_REFRESH_SECRET=change-me-run-npm-generate-secrets-yy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCS_KEY_FILE=./gcs-service-account.json

# SMTP — Gmail (same in local and production; see deployment.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

REDIS_URL=
# REDIS_URL=redis://localhost:6379
