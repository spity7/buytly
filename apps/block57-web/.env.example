# Used by Next.js for local dev: npm run dev
# Copy to `.env.local` (recommended). Optional: `.env` for non-secret defaults.

# Site tenant for API (sent as X-Site-Slug on every request — required on localhost)
NEXT_PUBLIC_SITE_SLUG=block57
NEXT_PUBLIC_SITE_NAME=Block 57
# Local dev (recommended). Production: https://block-57.com
NEXT_PUBLIC_SITE_PUBLIC_URL=http://localhost:3002
# NEXT_PUBLIC_SITE_PUBLIC_URL=https://block-57.com

NEXT_PUBLIC_API_URL=http://localhost:5025/api/v1
# NEXT_PUBLIC_API_URL=https://api.buytly.com/api/v1

OPENAPI_URL=http://localhost:5025/api/docs.json
# OPENAPI_URL=https://api.buytly.com/api/docs.json

# Slug of the single Block 57 project in the API (created by `npm run seed:block57` in server/).
# Do not rename the project in the dashboard — that changes its slug and needs a rebuild.
NEXT_PUBLIC_BLOCK57_PROJECT_SLUG=block-57

# Public site shows "Inquire" instead of prices unless this is `true`
NEXT_PUBLIC_SHOW_PRICES=false

# Must match GOOGLE_CLIENT_ID in server/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SUPPORT_PHONE=+233244777772
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+233 244 777 772
NEXT_PUBLIC_SUPPORT_EMAIL=info@block-57.com

# Google Tag Manager container id (e.g. GTM-XXXXXXX). Leave empty: no tracking
# code loads. The live WordPress site uses GTM-MBQHCVSP (consent to confirm).
NEXT_PUBLIC_GTM_ID=
