# Used by Next.js for local dev: npm run dev
# Copy to `.env.local` (recommended). Optional: `.env` for non-secret defaults.

# Site tenant for API (sent as X-Site-Slug on every request — required on localhost)
NEXT_PUBLIC_SITE_SLUG=buildwise
NEXT_PUBLIC_SITE_NAME=Buildwise Engineering
NEXT_PUBLIC_SITE_PUBLIC_URL=https://buildwise-engineering.com

NEXT_PUBLIC_API_URL=http://localhost:5025/api/v1
# NEXT_PUBLIC_API_URL=https://api.buytly.com/api/v1

OPENAPI_URL=http://localhost:5025/api/docs.json
# OPENAPI_URL=https://api.buytly.com/api/docs.json

# Must match GOOGLE_CLIENT_ID in server/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SUPPORT_PHONE=+96171703703
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+961 71 703 703
NEXT_PUBLIC_SUPPORT_EMAIL=info@buildwise-engineering.com
