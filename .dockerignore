# Repo-root context for docker compose (client + buildwise-web)
# Note: client/.dockerignore and apps/buildwise-web/.dockerignore apply only when
# build context is that subfolder; compose uses context "." so this file wins.

**/node_modules
**/.next
**/out
**/.git
**/.cursor
**/.vscode
**/coverage
**/*.md
!README.md
client/.env*
apps/buildwise-web/.env*
# API + shared packages not copied into frontend Dockerfiles
server/
packages/
**/.turbo
