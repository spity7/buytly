{
  "name": "buytly-client",
  "version": "2.1.0",
  "description": "Buytly real estate marketplace frontend",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,next -c yellow,cyan \"node scripts/watch-api.cjs\" \"next dev\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "gen:api": "node scripts/gen-api.cjs",
    "format:api": "prettier --write --log-level warn \"src/api/generated\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@react-google-maps/api": "^2.20.6",
    "@tanstack/react-query": "^5.101.2",
    "aos": "^2.3.4",
    "axios": "^1.18.1",
    "bootstrap": "5.3.8",
    "next": "16.2.10",
    "photoswipe": "^5.4.4",
    "prop-types": "15.8.1",
    "rc-slider": "^11.1.8",
    "react": "19.2.7",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.7",
    "react-intersection-observer": "^9.16.0",
    "react-photoswipe-gallery": "^3.1.1",
    "react-pro-sidebar": "^1.1.0",
    "react-select": "^5.10.1",
    "react-tooltip": "^5.28.1",
    "recharts": "2.15.3",
    "sass": "^1.101.0",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "9.27.0",
    "orval": "^7.13.2",
    "prettier": "^3.9.4"
  }
}
