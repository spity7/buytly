# Used by Next.js for local dev: npm run dev
# Copy to `.env.local` (recommended). Optional: `.env` for non-secret defaults.

NEXT_PUBLIC_API_URL=http://localhost:5025/api/v1
# NEXT_PUBLIC_API_URL=https://api.buytly.com/api/v1

OPENAPI_URL=http://localhost:5025/api/docs.json
# OPENAPI_URL=https://api.buytly.com/api/docs.json

# Must match GOOGLE_CLIENT_ID in server/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Footer / mobile menu support WhatsApp (wa.me uses digits from SUPPORT_PHONE)
NEXT_PUBLIC_SUPPORT_PHONE=+96171601751
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+961 71 601 751
