# Required — copy to .env.local and adjust per environment

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
OPENAPI_URL=http://localhost:5000/api/docs.json

# OAuth 2.0 Web client ID from Google Cloud Console (Credentials).
# In that client, add Authorized JavaScript origins for every URL you run the
# app on (no trailing slash), e.g. http://localhost:3000 for local dev.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Production example:
# NEXT_PUBLIC_API_URL=https://api.buytly.com/api/v1
# OPENAPI_URL=https://api.buytly.com/api/docs.json
