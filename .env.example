# Docker Compose — copy to .env in the repo root (never commit .env).
# Used by docker compose for build args and client runtime env.
# Server runtime env remains in server/.env (see server/.env.example).

NEXT_PUBLIC_API_URL=https://api.buytly.com/api/v1

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
