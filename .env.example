# Used by docker-compose for frontend build args
# Copy to .env in this folder before: docker compose up --build

NEXT_PUBLIC_API_URL=http://localhost:5025/api/v1
# NEXT_PUBLIC_API_URL=https://api.buytly.com/api/v1

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Buytly (client service) — baked into Next.js at Docker build
NEXT_PUBLIC_SUPPORT_PHONE=+96171601751
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+961 71 601 751
NEXT_PUBLIC_SUPPORT_EMAIL=buytlyonline@gmail.com

# Buildwise (buildwise-web Docker build) — baked into Next.js; for local dev use apps/buildwise-web/.env.local
# BUILDWISE_SITE_PUBLIC_URL=http://localhost:3001
BUILDWISE_SITE_PUBLIC_URL=https://buildwise-engineering.com

# Partner listing URLs from the API (Buytly → Buildwise links) — set in server/.env, not here:
# SITE_PUBLIC_URL_BUILDWISE=http://localhost:3001
# SITE_PUBLIC_URL_BUYTLY=http://localhost:3000
BUILDWISE_SUPPORT_PHONE=+96171703703
BUILDWISE_SUPPORT_PHONE_DISPLAY=+961 71 703 703
BUILDWISE_SUPPORT_EMAIL=info@buildwise-engineering.com

# Block 57 (block57-web Docker build) — baked into Next.js; for local dev use apps/block57-web/.env.local
# BLOCK57_SITE_PUBLIC_URL=http://localhost:3002
BLOCK57_SITE_PUBLIC_URL=https://block-57.com

# Partner listing URLs from the API (Buytly → Block 57 links) — set in server/.env, not here:
# SITE_PUBLIC_URL_BLOCK57=http://localhost:3002

# Slug of the Block 57 project created by `npm run seed:block57` (renaming the project changes it)
BLOCK57_PROJECT_SLUG=block-57
# Public site shows "Inquire" instead of prices unless this is `true`
BLOCK57_SHOW_PRICES=false
BLOCK57_SUPPORT_PHONE=+233244777772
BLOCK57_SUPPORT_PHONE_DISPLAY=+233 244 777 772
BLOCK57_SUPPORT_EMAIL=info@block-57.com
